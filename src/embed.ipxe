#!ipxe

# Distans-version - används för datorer UTANFÖR hemmanatverket.
# Anvander publik IP + port forwarding istället för lokal TrueNAS-IP.

set truenas_ip 158.174.149.16
set truenas_port 8888

echo Startar iPXE - hamtar netboot.xyz-meny fran ${truenas_ip}:${truenas_port}...

dhcp

chain http://${truenas_ip}:${truenas_port}/menu.ipxe || goto failed
goto done

:failed
echo Kunde inte öppna menyn på ${truenas_ip}:${truenas_port}
echo Kontrollera port forwarding-regeln i routern
shell

:done
